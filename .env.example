# ============================================================
# CompetiTour Environment Variables
# Copy this file to .env and fill in real values
# NEVER commit .env to version control
# ============================================================

# ---------- PostgreSQL ----------
POSTGRES_USER=competitour
POSTGRES_PASSWORD=competitour_secure_2026
POSTGRES_DB=competitour
DATABASE_URL=postgresql+asyncpg://competitour:competitour_secure_2026@postgres:5432/competitour

# ---------- Redis ----------
REDIS_URL=redis://redis:6379/0

# ---------- Torch Labs Residential Proxy ----------
TORCH_API_KEY=your_torch_api_key_here
TORCH_GATEWAY_HOST=gate.torchproxies.com
TORCH_GATEWAY_PORT=6011
TORCH_USERNAME=your_sub_user_username
TORCH_PASSWORD=your_sub_user_password

# ---------- Torch Labs ISP Proxy ----------
ISP_PROXY_HOST=0.0.0.0
ISP_PROXY_PORT=0
ISP_PROXY_USERNAME=your_isp_username
ISP_PROXY_PASSWORD=your_isp_password

# ---------- Google Gemini ----------
GEMINI_API_KEY=your_gemini_api_key_here

# ---------- JWT Auth ----------
JWT_SECRET_KEY=changeme_jwt_secret_at_least_32_chars
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440

# ---------- App ----------
ENVIRONMENT=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# ---------- Frontend ----------
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url_here
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_publishable_key_here
